```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
build/
dist/
*.egg-info/

# Logs
*.log

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Coverage reports
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/

# OS files
.DS_Store
Thumbs.db
```